# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protects the internal background function dispatch
INTERNAL_FUNCTION_TOKEN=

# Google Calendar OAuth refresh-token flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Appointment and worker tuning
CALENDAR_APPOINTMENT_DURATION_MINUTES=60
CALENDAR_WORKER_MAX_ATTEMPTS=5


